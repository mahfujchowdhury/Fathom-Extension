{
  "manifest_version": 3,
  "name": "Fathom",
  "short_name": "Fathom",
  "version": "0.1.0",
  "description": "Peel apart any website: inspect elements, export code, read its design system, capture screenshots, and compare responsive layouts.",
  "author": "Fathom",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fathom — open website tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "clipboardWrite",
    "webNavigation",
    "contextMenus",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "ui/dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["ui/workspace.css", "icons/logo.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
